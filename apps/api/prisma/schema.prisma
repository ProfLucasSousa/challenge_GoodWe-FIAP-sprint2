generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum VehicleType {
  BEV
  PHEV
}

enum PhaseType {
  SINGLE_PHASE
  THREE_PHASE
}

enum ChargerStatus {
  AVAILABLE
  CHARGING
  OFFLINE
  FAULT
  UNKNOWN
}

enum ChargerProvider {
  MOCK
  GOODWE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
  ERROR
  PENDING_REVIEW
}

enum SessionType {
  INTERNAL
  IMPORTED
}

enum SessionSource {
  MOCK
  SEMS
  MODBUS
  MANUAL
}

enum ReadingSource {
  MOCK
  SEMS
  MODBUS
}

enum DataQuality {
  VALID
  PARTIAL
  INVALID
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  CANCELLED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
}

enum IntegrationStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model Unit {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  block           String?
  description     String?
  responsibleName String?
  users           User[]
  invoices        Invoice[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  email        String            @unique
  passwordHash String
  role         UserRole          @default(USER)
  active       Boolean           @default(true)
  unitId       String?           @db.Uuid
  unit         Unit?             @relation(fields: [unitId], references: [id])
  vehicles     Vehicle[]
  rfidCards    RfidCard[]
  sessions     ChargingSession[]
  auditEvents  AuditEvent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([unitId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Vehicle {
  id           String            @id @default(uuid()) @db.Uuid
  ownerId      String            @db.Uuid
  owner        User              @relation(fields: [ownerId], references: [id])
  nickname     String?
  model        String
  licensePlate String            @unique
  type         VehicleType
  active       Boolean           @default(true)
  sessions     ChargingSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
}

model RfidCard {
  id        String            @id @default(uuid()) @db.Uuid
  uid       String            @unique
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  active    Boolean           @default(true)
  sessions  ChargingSession[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Charger {
  id             String            @id @default(uuid()) @db.Uuid
  serialNumber   String            @unique
  name           String
  model          String
  nominalPowerKw Decimal           @db.Decimal(8, 3)
  phaseType      PhaseType
  location       String
  status         ChargerStatus     @default(UNKNOWN)
  provider       ChargerProvider   @default(MOCK)
  externalId     String?
  lastSeenAt     DateTime?
  sessions       ChargingSession[]
  readings       ChargingReading[]
  auditEvents    AuditEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provider, externalId])
  @@index([externalId])
  @@index([status])
  @@index([lastSeenAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model ChargingSession {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String?           @db.Uuid
  user                User?             @relation(fields: [userId], references: [id])
  vehicleId           String?           @db.Uuid
  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id])
  chargerId           String            @db.Uuid
  charger             Charger           @relation(fields: [chargerId], references: [id])
  rfidCardId          String?           @db.Uuid
  rfidCard            RfidCard?         @relation(fields: [rfidCardId], references: [id])
  externalId          String?
  sessionType         SessionType       @default(INTERNAL)
  startedAt           DateTime
  endedAt             DateTime?
  energyKwh           Decimal           @default(0) @db.Decimal(12, 3)
  observedEnergyKwh   Decimal?          @db.Decimal(12, 3)
  calculatedEnergyKwh Decimal?          @db.Decimal(12, 3)
  averagePowerKw      Decimal?          @db.Decimal(8, 3)
  status              SessionStatus     @default(ACTIVE)
  observedStatus      SessionStatus?
  source              SessionSource     @default(MOCK)
  dataQuality         DataQuality       @default(VALID)
  reviewReason        String?
  readings            ChargingReading[]
  invoiceItem         InvoiceItem?
  auditEvents         AuditEvent[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([source, externalId])
  @@unique([chargerId, source, startedAt])
  @@index([externalId])
  @@index([sessionType])
  @@index([status])
  @@index([userId])
  @@index([vehicleId])
  @@index([chargerId])
  @@index([rfidCardId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model ChargingReading {
  id                   String           @id @default(uuid()) @db.Uuid
  externalId           String?
  sessionId            String?          @db.Uuid
  session              ChargingSession? @relation(fields: [sessionId], references: [id])
  chargerId            String           @db.Uuid
  charger              Charger          @relation(fields: [chargerId], references: [id])
  externalTimestamp    DateTime?
  timestamp            DateTime
  powerKw              Decimal?         @db.Decimal(8, 3)
  currentA             Decimal?         @db.Decimal(10, 3)
  voltageV             Decimal?         @db.Decimal(10, 3)
  accumulatedEnergyKwh Decimal?         @db.Decimal(12, 3)
  source               ReadingSource
  rawMetadata          Json?
  createdAt            DateTime         @default(now())

  @@unique([source, externalId])
  @@unique([chargerId, source, externalTimestamp])
  @@index([sessionId])
  @@index([chargerId])
  @@index([externalTimestamp])
  @@index([timestamp])
  @@index([createdAt])
}

model Tariff {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  pricePerKwh    Decimal   @db.Decimal(12, 4)
  operationalFee Decimal   @default(0) @db.Decimal(12, 2)
  validFrom      DateTime
  validUntil     DateTime?
  active         Boolean   @default(true)

  @@index([validFrom])
  @@index([validUntil])
  @@index([active])
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  unitId          String        @db.Uuid
  unit            Unit          @relation(fields: [unitId], references: [id])
  referenceMonth  String
  totalKwh        Decimal       @default(0) @db.Decimal(12, 3)
  energyAmount    Decimal       @default(0) @db.Decimal(12, 2)
  operationalFees Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(OPEN)
  generatedAt     DateTime      @default(now())
  closedAt        DateTime?
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]

  @@unique([unitId, referenceMonth])
  @@index([unitId])
  @@index([referenceMonth])
  @@index([status])
  @@index([generatedAt])
  @@index([closedAt])
}

model InvoiceItem {
  id                String          @id @default(uuid()) @db.Uuid
  invoiceId         String          @db.Uuid
  invoice           Invoice         @relation(fields: [invoiceId], references: [id])
  chargingSessionId String          @unique @db.Uuid
  chargingSession   ChargingSession @relation(fields: [chargingSessionId], references: [id])
  energyKwh         Decimal         @db.Decimal(12, 3)
  pricePerKwh       Decimal         @db.Decimal(12, 4)
  energyAmount      Decimal         @default(0) @db.Decimal(12, 2)
  operationalFee    Decimal         @db.Decimal(12, 2)
  amount            Decimal         @db.Decimal(12, 2)

  @@index([invoiceId])
}

model AuditEvent {
  id                String           @id @default(uuid()) @db.Uuid
  source            ChargerProvider?
  externalId        String?
  externalTimestamp DateTime?
  type              String
  severity          AuditSeverity    @default(INFO)
  userId            String?          @db.Uuid
  user              User?            @relation(fields: [userId], references: [id])
  chargerId         String?          @db.Uuid
  charger           Charger?         @relation(fields: [chargerId], references: [id])
  chargingSessionId String?          @db.Uuid
  chargingSession   ChargingSession? @relation(fields: [chargingSessionId], references: [id])
  message           String
  metadata          Json?
  createdAt         DateTime         @default(now())

  @@unique([source, externalId])
  @@index([userId])
  @@index([chargerId])
  @@index([chargingSessionId])
  @@index([severity])
  @@index([createdAt])
  @@index([externalTimestamp])
}

model IntegrationSync {
  id              String            @id @default(uuid()) @db.Uuid
  provider        ChargerProvider
  resourceType    String
  startedAt       DateTime
  finishedAt      DateTime?
  status          IntegrationStatus
  recordsReceived Int               @default(0)
  recordsCreated  Int               @default(0)
  recordsUpdated  Int               @default(0)
  errorMessage    String?
  metadata        Json?

  @@index([status])
  @@index([startedAt])
  @@index([finishedAt])
}
