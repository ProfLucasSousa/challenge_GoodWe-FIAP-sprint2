# Runtime
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://chargeops:chargeops@localhost:5432/chargeops?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
SEED_ADMIN_PASSWORD=
VITE_ENABLE_DEMO=true
DEMO_MODE=true

# DEMO_MODE composes capabilities reais autorizadas com fallback MOCK identificado.
# Fora do DEMO, selecione um provider único.
CHARGER_PROVIDER=mock

# Supply real credentials only in a local .env or secret manager. Never commit values.
GOODWE_SEMS_USERNAME=
GOODWE_SEMS_PASSWORD=
GOODWE_READ_ONLY=true
INTELLIGENCE_TIMEZONE=America/Sao_Paulo
ASSISTANT_PROVIDER=deterministic
