{
  "name": "ev-chargeops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @ev-chargeops/shared build && pnpm --parallel --filter @ev-chargeops/api --filter @ev-chargeops/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @ev-chargeops/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @ev-chargeops/shared build && pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ev-chargeops/api prisma:generate",
    "db:migrate": "pnpm --filter @ev-chargeops/api prisma:migrate",
    "db:seed": "pnpm --filter @ev-chargeops/api prisma:seed",
    "demo:seed": "pnpm --filter @ev-chargeops/api demo:seed",
    "demo:reset": "pnpm --filter @ev-chargeops/api demo:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
